<div class="row">
    <div class="col-lg-12">
        <div class="p-4">
            <h1 class="h1 mb-4" style="text-align: center;">@Model?.Title</h1>
            <hr>
            <div> <img src="~/img/@Model?.Image" class="img-fluid " alt="" width="100%" height="100%"></div>
            <br>
            <div class="text-center">
                @Html.Raw(@Model?.Content)
            </div>


        </div>
    </div>
</div>

