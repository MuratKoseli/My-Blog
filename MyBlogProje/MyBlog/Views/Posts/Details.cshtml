@model Post

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/media.css" asp-append-version="true">
    <title>Document</title>
</head>

<body>
    <div class="row">
        <div class="col-lg-12">
            <div class="p-4">
                <h1 class="h1 mb-4" style="text-align: center;">@Model.Title</h1>
                <hr>
                <div>@Model.Description</div>
                <br>
                <div><img src="~/img/@Model.Image" class="img-fluid " alt="" width="100%" height="100%"></div>
                <br>
                <div class="text-center post-content">
                    @Html.Raw(@Model.Content)
                </div>
            </div>
        </div>
    </div>
    </div>
</body>

</html>