<div class="row">
    <div class="col-lg-12">
        <div class="p-4" style="background-color: #e2e0c8ba">
            <h1 class="h4 mb-4">Şiirler</h1>
            <hr>
            @foreach (var post in Model)
            {
                <div class="card bg-transparent border-0 mb-3">
                    <div class="row">
                        <div class="col-6">
                            <a href="/posts/details/@post.Url"><img src="~/img/@post.Image" class="img-fluid " alt=""
                                    style="width: 100%;"></a>

                        </div>
                        <div class="col-6">
                            <h5>
                                <a href="/posts/details/@post.Url" class="btn-link fw-bold"
                                    style="color: black; text-decoration: none;">
                                    @post.Title
                                </a>
                            </h5>
                            <p class="text-muted small">@post.Description</p>
                        </div>
                    </div>
                </div>
                <hr class="my-3">
            }


            @if (ViewBag.TotalPages > 1)
            {
                <nav class="pagination" style="padding: 5px; border-radius: 5px;">
                    <ul class="pagination">
                        @if (ViewBag.CurrentPage > 1)
                        {
                            <li class="page-item">
                                <a href="@Url.Action("Index", new { category = ViewBag.Category, page = ViewBag.CurrentPage - 1 })"
                                    class="page-link" style="background-color: #efeff28a; color: black;">Önceki</a>
                            </li>
                        }

                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                                <a href="@Url.Action("Index", new { category = ViewBag.Category, page = i })" class="page-link"
                                    style="background-color:#eff3f28a; color: black;">@i</a>
                            </li>
                        }

                        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                        {
                            <li class="page-item">
                                <a href="@Url.Action("Index", new { category = ViewBag.Category, page = ViewBag.CurrentPage + 1 })"
                                    class="page-link" style=" background-color: #eff3f28a; color: black;">Sonraki</a>
                            </li>
                        }
                    </ul>
                </nav>
            }

            @* <nav class="pagination" style="padding: 5px; border-radius: 5px;">
                <li class="page-item"><a href="#" class="page-link" style="background-color:  #eff3f28a" ;">1</a></li>
                <li class="page-item"><a href="#" class="page-link">2</a></li>
                <li class="page-item"><a href="#" class="page-link">3</a></li>
            </nav> *@
        </div>
    </div>

</div>
</div>
