<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/home.css" asp-append-version="true">

    <title>Post Düzeni</title>
</head>
<body>
    <div class="quote h4 mb-4">"Ölümün bizleri duymaması için çıkarmadığımız sesimiz, yaşamın bizi bulmasına da engel oldu. Ölüme yakalanmadan yaşamı aramaya çalıştık ve bize tanık olan Tanrı’dır."</div>
    <hr>
    <div class=""></div>
    <div class="image-container">
        <img src="@Url.Content("~/img/prs.jpg")" class="img-fluid" alt="Resim">

    </div>
    <div class="content-container">
        <div class="divider"></div>
        <div class="posts">
            @foreach (var art in Model) {
                <div class="post">
                    <a href="/home/details/@art.Url">
                        <img src="~/img/@art.Image" class="img-fluid" alt="">
                    </a>
                    <br>
                    <h5>
                        <a href="/home/details/@art.Url" class="btn-link fw-bold" style="color: black; text-decoration: none;">
                            @art.Title
                        </a>
                    </h5>
                    <p class="text-muted small">@art.Description</p>
                </div>
            }
        </div>
    </div>
</body>
</html>
