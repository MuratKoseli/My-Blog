@model List<Category>

<ul class="dropdown-menu custom-dropdown">
    @foreach (var category in Model)
    {
        <li>
            <a class="dropdown-item" href="/posts?category=@category.CategoryName">@category.CategoryName</a>
        </li>
    }
</ul>




