@model List<Post>

<div class="card mb-3 " style="background-color: #eff3f23d; border-radius: 0;">
    <div class="card-header" style="background-color: #dee2e6; border-radius: 0;">
        <h5 class="card-title mb-0">Son Eklenenler</h5>
    </div>
    <div class="card-body">
        @foreach (var post in Model)
        {
            <div class="post-item py-2 px-3">
                <h6 class="mb-0">
                    <a href="#" class="post-link" style="color:black;">@post.Title</a>
                </h6>
            </div>
            <hr class="my-2">
        }
    </div>
</div>